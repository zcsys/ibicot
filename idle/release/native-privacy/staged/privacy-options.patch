+/// English presentation copy; LocalizedText applies the existing pseudolocale.
+abstract final class AdPrivacyCopy {
+  static const title = 'Advertising privacy';
+  static const description =
+      'Manage the ad provider’s privacy choices for optional ads. Changes apply to future ads. Support you already earned stays yours.';
+  static const options = 'Advertising privacy options';
+  static const check = 'Check advertising privacy options';
+  static const unavailable =
+      'Advertising privacy options could not be loaded. Retry when connected. Free Crew Briefing remains available.';
+  static const waiting =
+      'Waiting for advertising privacy options. Your harbor remains available.';
+}
